<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PushScroll"
            android:textColor="@color/lime"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="1 pushup = 1 Short"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Counter card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUSHUPS THIS SESSION"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/txtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text"
                android:textSize="88sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All time: 0"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <com.teserakt.pushscroll.LevelView
                android:id="@+id/levelView"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stopped"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Start tracking"
                android:textAllCaps="false"
                android:textColor="#FF0B0D10"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnShorts"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:text="Open Shorts"
                    android:textAllCaps="false"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:text="Reset count"
                    android:textAllCaps="false"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Setup card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="SETUP"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnCam"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn"
                    android:paddingHorizontal="14dp"
                    android:text="Allow"
                    android:textAllCaps="false"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAcc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shorts control (Accessibility)"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAcc"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn"
                    android:paddingHorizontal="14dp"
                    android:text="Enable"
                    android:textAllCaps="false"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtAccHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="If Android says it's a restricted setting: open App info for PushScroll → ⋮ (top right) → Allow restricted settings, then try again."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Options card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="OPTIONS"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

            <Switch
                android:id="@+id/swBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Block manual swiping on Shorts (taps still work)"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Treat all of YouTube as Shorts (use if Shorts isn't detected)"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtSens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sensitivity: 50"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/seekSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raise it if half-reps aren't counting, lower it if small head nods count."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- How-to card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="HOW TO USE\n1. Allow Camera and enable Shorts control above.\n2. Tap Start tracking, then Open Shorts.\n3. Put the phone on the floor in front of you, screen facing up toward your face (front camera looking at you, not from the side). Lean it on something so it tilts toward you.\n4. Every full pushup (down and back up) scrolls one Short. Your count shows at the top-right of YouTube.\n5. Tap the screen to pause/like as usual. Swiping does nothing while tracking is on.\n6. Tap Stop (here or in the notification) to get normal scrolling back."
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
